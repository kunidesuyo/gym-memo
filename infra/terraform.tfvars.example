# これをコピーして terraform.tfvars を作る（実ファイルは .gitignore 済み）。
#   cp terraform.tfvars.example terraform.tfvars
#
# ⚠️ API トークンはここに書かない。tfstate に平文で残る。
#    実行時に環境変数で渡す:
#      CLOUDFLARE_API_TOKEN="$(security find-generic-password -s cloudflare-terraform -w)" terraform plan

# account_id は `npx wrangler whoami` で出る。
# ID 自体は機密ではない（API トークンが無いと何もできず、トークンがあれば
# wrangler d1 list / whoami で自力で引ける）が、.example は見本なので
# 実値は入れずコピー先の terraform.tfvars にだけ書く。
account_id    = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
allowed_email = "you@example.com"

# 以下は variables.tf に既定値があるので、変えたいときだけ書く
# zone_name     = "kuni-app.dev"
# app_subdomain = "gym-memo"
# team_name     = "kuni-app"
