{
  "name": "gym-memo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply gym-memo --local",
    "db:generate": "pnpm --filter api db:generate",
    "db:seed:local": "wrangler d1 execute gym-memo --local --file=apps/api/seed.sql",
    "db:reset:local": "rm -rf .wrangler && pnpm db:migrate:local && pnpm db:seed:local"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "typescript": "^7.0.2",
    "wrangler": "^4.135.0"
  },
  "intent": {
    "skills": [
      "*"
    ]
  }
}
