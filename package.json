{
  "name": "gym-memo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply gym-memo --local"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "typescript": "^7.0.2",
    "wrangler": "^4.135.0"
  }
}
