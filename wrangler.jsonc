{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gym-memo",
  "main": "apps/api/src/index.ts",
  // vitest-pool-workers が同梱する workerd は wrangler 同梱版より古いことがある。
  // 両方が受け付ける日付に合わせる（テスト側の上限が 2026-08-22 だった）。
  "compatibility_date": "2026-08-22",

  // ⚠️ 無認証の公開 URL を作らせない。**外さないこと。**
  // 既定のままデプロイすると gym-memo.<subdomain>.workers.dev が自動で生え、
  // 誰でも D1 を読み書きできてしまう。
  // 下の routes は Access で保護済みだが、workers.dev は Access の対象外の
  // 別ホスト名なので、生やすと保護を迂回する裏口になる。
  "workers_dev": false,
  "preview_urls": false,

  // 公開ホスト名。custom_domain: true にすると wrangler が DNS レコードの作成と
  // Worker への紐付けまでやる（DNS を Terraform で管理しないのはこのため）。
  // このホスト名は Cloudflare Access の検問下にある（infra/main.tf）。
  // ⚠️ 順序: Access を先に張ってからここを足すこと。逆だと保護が効くまでの間、
  //    無認証で公開される窓が開く。
  "routes": [{ "pattern": "gym-memo.kuni-app.dev", "custom_domain": true }],

  // logs と traces は別々に指定が必要。enabled だけではトレースは有効にならない。
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },

  // 静的アセット = Vite がビルドした SPA。
  // /api/* だけを Worker に回し、それ以外はアセット配信 + SPA フォールバック。
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // database_id は本番 D1（APAC リージョン）のもの。秘密ではないのでコミットしてよい
  // （これ単体では何もできず、アクセスにはアカウントの認証情報が要る）。
  // ローカル開発では参照されず、.wrangler 配下の SQLite が使われる。
  // ⚠️ binding は DB のまま。wrangler d1 create は gym_memo を提案してくるが、
  //    変えるとコード側の c.env.DB が全部壊れる。
  // migrations_dir を省くと wrangler はリポジトリ直下の ./migrations を探して失敗する。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gym-memo",
      "database_id": "a009e578-dc32-401a-94b4-f27282209cdc",
      "migrations_dir": "apps/api/migrations"
    }
  ]
}
